{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
    },
    "spec_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
    },
    "spec_hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(missing|[a-f0-9]{64})$"
    },
    "files": {
      "type": "object",
      "additionalProperties": true
    },
    "pending": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
      },
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  },
  "required": [
    "id",
    "spec_id",
    "spec_hash",
    "files",
    "pending",
    "evidence_ids",
    "created_at"
  ],
  "additionalProperties": false
}
