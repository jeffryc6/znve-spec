{
  "description": "Casos de conformidad del contrato de respuesta (master_spec.json, mcp.contract). Los ejecutan las dos implementaciones, el servidor MCP y znve_skill.py, contra un workspace temporal idéntico, en orden. 'expect' es un subconjunto del resultado; 'counts' compara longitudes; 'content_contains', 'content_excludes' y 'result_excludes' comprueban texto.",
  "files": {
    "prod.ts": "export const x = 1;\n",
    "lines.txt": "l1\nl2\nl3\nl4\n",
    "io.py": "import os\nfetch('x')\nopen('f')\nDELETE FROM t WHERE id = 1;\ntry:\n    f()\nexcept:\n    pass\nvar r = task.Result;\ntime.sleep(1)\n",
    ".env": "TOKEN=CANARY-12345",
    ".env.local": "TOKEN=CANARY-12345",
    "id_rsa": "TOKEN=CANARY-12345",
    "server.pem": "TOKEN=CANARY-12345",
    "credentials.json": "TOKEN=CANARY-12345",
    ".env.example": "TOKEN=changeme",
    "bin.dat": {"base64": "UEsAAwQ="},
    "big.txt": {"fill": "a", "bytes": 1048577},
    "docs/": null,
    ".git/config": "[core]\n"
  },
  "outside_files": {"secret.txt": "TOP-SECRET"},
  "cases": [
    {"id": "help-default", "tool": "znve_help", "args": {}, "expect": {"status": "SUCCESS", "topic": "commands"}},
    {"id": "help-modes", "tool": "znve_help", "args": {"topic": "modes"}, "expect": {"status": "SUCCESS", "topic": "modes"}},

    {"id": "forensic-whole", "tool": "znve_forensic_scan", "args": {"file_path": "lines.txt"},
     "expect": {"status": "SUCCESS", "file": "lines.txt", "size_bytes": 12, "total_lines": 4, "range": null,
                "side_effects": {"file_system_io": false, "network_calls": false, "database_mutations": false},
                "red_zones": {"empty_catch_blocks": 0, "thread_blocking_calls": 0}},
     "content_contains": ["l1\nl2\nl3\nl4"]},
    {"id": "forensic-range", "tool": "znve_forensic_scan", "args": {"file_path": "lines.txt", "start_line": 2, "end_line": 3},
     "expect": {"status": "SUCCESS", "total_lines": 4, "range": {"start_line": 2, "end_line": 3}},
     "content_contains": ["\nl2\nl3\n"], "content_excludes": ["l1", "l4"]},
    {"id": "forensic-open-end", "tool": "znve_forensic_scan", "args": {"file_path": "lines.txt", "start_line": 4},
     "expect": {"status": "SUCCESS", "range": {"start_line": 4, "end_line": 4}}},
    {"id": "forensic-open-start", "tool": "znve_forensic_scan", "args": {"file_path": "lines.txt", "end_line": 1},
     "expect": {"status": "SUCCESS", "range": {"start_line": 1, "end_line": 1}}},
    {"id": "forensic-inverted", "tool": "znve_forensic_scan", "args": {"file_path": "lines.txt", "start_line": 3, "end_line": 2},
     "expect": {"status": "REJECTED", "code": "BAD_RANGE"}, "result_excludes": ["l1", "l2"]},
    {"id": "forensic-end-beyond", "tool": "znve_forensic_scan", "args": {"file_path": "lines.txt", "end_line": 99},
     "expect": {"status": "REJECTED", "code": "BAD_RANGE"}},
    {"id": "forensic-start-beyond", "tool": "znve_forensic_scan", "args": {"file_path": "lines.txt", "start_line": 5},
     "expect": {"status": "REJECTED", "code": "BAD_RANGE"}},
    {"id": "forensic-escape", "tool": "znve_forensic_scan", "args": {"file_path": "../outside/secret.txt"},
     "expect": {"status": "REJECTED", "code": "OUTSIDE_WORKSPACE"}, "result_excludes": ["TOP-SECRET"]},
    {"id": "forensic-missing", "tool": "znve_forensic_scan", "args": {"file_path": "no-existe.txt"},
     "expect": {"status": "ERROR", "code": "NOT_FOUND"}},
    {"id": "forensic-directory", "tool": "znve_forensic_scan", "args": {"file_path": "docs"},
     "expect": {"status": "REJECTED", "code": "NOT_A_FILE"}},
    {"id": "forensic-binary", "tool": "znve_forensic_scan", "args": {"file_path": "bin.dat"},
     "expect": {"status": "REJECTED", "code": "BINARY_FILE"}},
    {"id": "forensic-too-large", "tool": "znve_forensic_scan", "args": {"file_path": "big.txt"},
     "expect": {"status": "REJECTED", "code": "TOO_LARGE"}},
    {"id": "forensic-secret-env", "tool": "znve_forensic_scan", "args": {"file_path": ".env"},
     "expect": {"status": "REJECTED", "code": "SECRET_DENIED"}, "result_excludes": ["CANARY"]},
    {"id": "forensic-secret-env-local", "tool": "znve_forensic_scan", "args": {"file_path": ".env.local"},
     "expect": {"status": "REJECTED", "code": "SECRET_DENIED"}, "result_excludes": ["CANARY"]},
    {"id": "forensic-secret-key", "tool": "znve_forensic_scan", "args": {"file_path": "id_rsa"},
     "expect": {"status": "REJECTED", "code": "SECRET_DENIED"}, "result_excludes": ["CANARY"]},
    {"id": "forensic-secret-pem", "tool": "znve_forensic_scan", "args": {"file_path": "server.pem"},
     "expect": {"status": "REJECTED", "code": "SECRET_DENIED"}, "result_excludes": ["CANARY"]},
    {"id": "forensic-secret-credentials", "tool": "znve_forensic_scan", "args": {"file_path": "credentials.json"},
     "expect": {"status": "REJECTED", "code": "SECRET_DENIED"}, "result_excludes": ["CANARY"]},
    {"id": "forensic-secret-case", "tool": "znve_forensic_scan", "args": {"file_path": ".ENV"},
     "expect": {"status": "REJECTED", "code": "SECRET_DENIED"}, "result_excludes": ["CANARY"]},
    {"id": "forensic-secret-template", "tool": "znve_forensic_scan", "args": {"file_path": ".env.example"},
     "expect": {"status": "SUCCESS", "file": ".env.example"}, "content_contains": ["changeme"]},
    {"id": "forensic-signals", "tool": "znve_forensic_scan", "args": {"file_path": "io.py"},
     "expect": {"status": "SUCCESS", "side_effects": {"file_system_io": true, "network_calls": true, "database_mutations": true},
                "red_zones": {"empty_catch_blocks": 1, "thread_blocking_calls": 2}}},

    {"id": "validate-ok", "tool": "znve_validate_contract", "args": {"contract_code": "interface User { readonly id: string }"},
     "expect": {"status": "APPROVED", "passed": true, "violations": []}},
    {"id": "validate-select-star", "tool": "znve_validate_contract", "args": {"contract_code": "q = 'select   * from users'"},
     "expect": {"status": "REJECTED", "code": "CONTRACT_VIOLATION", "passed": false}, "counts": {"violations": 1}},
    {"id": "validate-find-empty", "tool": "znve_validate_contract", "args": {"contract_code": "db.users.find({ })"},
     "expect": {"status": "REJECTED", "code": "CONTRACT_VIOLATION"}, "counts": {"violations": 1}},
    {"id": "validate-default-banned", "tool": "znve_validate_contract", "args": {"contract_code": "import axios from 'axios';"},
     "expect": {"status": "REJECTED", "code": "CONTRACT_VIOLATION"}, "counts": {"violations": 1}},
    {"id": "validate-explicit-banned", "tool": "znve_validate_contract", "args": {"contract_code": "import _ from 'lodash';", "banned_libraries": ["lodash"]},
     "expect": {"status": "REJECTED", "code": "CONTRACT_VIOLATION"}, "counts": {"violations": 1}},
    {"id": "validate-substring", "tool": "znve_validate_contract", "args": {"contract_code": "class Ratio:\n    radio: int\n", "banned_libraries": ["io", "rat"]},
     "expect": {"status": "APPROVED", "passed": true}},
    {"id": "validate-blank", "tool": "znve_validate_contract", "args": {"contract_code": "   "},
     "expect": {"status": "REJECTED", "code": "BAD_ARGUMENT"}},

    {"id": "audit-clean", "tool": "znve_audit_resources", "args": {"code_snippet": "var a = api.ResultSet; y.ResultCode = 0;"},
     "expect": {"status": "SUCCESS", "risk_level": "CLEAN", "clean": true, "findings_count": 0, "findings": []}},
    {"id": "audit-blocking-task", "tool": "znve_audit_resources", "args": {"code_snippet": "var r = task.Result;"},
     "expect": {"status": "SUCCESS", "risk_level": "HIGH", "clean": false, "findings_count": 1}},
    {"id": "audit-wakelock", "tool": "znve_audit_resources", "args": {"code_snippet": "mWakeLock.acquire();"},
     "expect": {"status": "SUCCESS", "risk_level": "HIGH", "clean": false, "findings_count": 1}},
    {"id": "audit-busy-wait", "tool": "znve_audit_resources", "args": {"code_snippet": "while True: pass"},
     "expect": {"status": "SUCCESS", "risk_level": "MEDIUM", "clean": false, "findings_count": 1}},

    {"id": "write-ok", "tool": "znve_surgical_write", "args": {"target_file": "app/ok.py", "code_content": "X = 2\n", "disposal_pattern": "not_applicable"},
     "expect": {"status": "SUCCESS", "file": "app/ok.py", "bytes_written": 6}},
    {"id": "write-silent-catch", "tool": "znve_surgical_write", "args": {"target_file": "app/bad.py", "code_content": "try:\n    f()\nexcept:\n    pass\n", "disposal_pattern": "finally"},
     "expect": {"status": "REJECTED", "code": "SILENT_CATCH"}},
    {"id": "write-undisposed", "tool": "znve_surgical_write", "args": {"target_file": "app/io.py", "code_content": "f = open('x')\n", "disposal_pattern": "not_applicable"},
     "expect": {"status": "REJECTED", "code": "UNDISPOSED_RESOURCE"}},
    {"id": "write-escape", "tool": "znve_surgical_write", "args": {"target_file": "../outside/pwned.txt", "code_content": "x", "disposal_pattern": "not_applicable"},
     "expect": {"status": "REJECTED", "code": "OUTSIDE_WORKSPACE"}},
    {"id": "write-protected", "tool": "znve_surgical_write", "args": {"target_file": ".git/config", "code_content": "x", "disposal_pattern": "not_applicable"},
     "expect": {"status": "REJECTED", "code": "PROTECTED_DIR"}},
    {"id": "write-secret", "tool": "znve_surgical_write", "args": {"target_file": ".env", "code_content": "X=1", "disposal_pattern": "not_applicable"},
     "expect": {"status": "REJECTED", "code": "SECRET_DENIED"}},
    {"id": "write-secret-template", "tool": "znve_surgical_write", "args": {"target_file": ".env.sample", "code_content": "X=", "disposal_pattern": "not_applicable"},
     "expect": {"status": "SUCCESS", "file": ".env.sample"}},

    {"id": "scaffold-ok", "tool": "znve_scaffold_harness", "args": {"harness_directory": "tests/characterization", "test_filename": "test_legacy.py", "harness_code": "pass\n"},
     "expect": {"status": "SUCCESS", "file": "tests/characterization/test_legacy.py"}},
    {"id": "scaffold-never-overwrites", "tool": "znve_scaffold_harness", "args": {"harness_directory": "tests/characterization", "test_filename": "test_legacy.py", "harness_code": "CAMBIADO\n"},
     "expect": {"status": "REJECTED", "code": "ALREADY_EXISTS"}},
    {"id": "scaffold-sandbox", "tool": "znve_scaffold_harness", "args": {"harness_directory": "sandbox", "test_filename": "probe.py", "harness_code": "pass\n"},
     "expect": {"status": "SUCCESS", "file": "sandbox/probe.py"}},
    {"id": "scaffold-not-tests", "tool": "znve_scaffold_harness", "args": {"harness_directory": "src", "test_filename": "h.txt", "harness_code": "x"},
     "expect": {"status": "REJECTED", "code": "NOT_HARNESS_DIR"}},
    {"id": "scaffold-substring", "tool": "znve_scaffold_harness", "args": {"harness_directory": "latest", "test_filename": "h.txt", "harness_code": "x"},
     "expect": {"status": "REJECTED", "code": "NOT_HARNESS_DIR"}},
    {"id": "scaffold-filename-with-path", "tool": "znve_scaffold_harness", "args": {"harness_directory": "tests/characterization", "test_filename": "../../prod.ts", "harness_code": "OVERWRITTEN"},
     "expect": {"status": "REJECTED", "code": "BAD_ARGUMENT"}},
    {"id": "scaffold-secret", "tool": "znve_scaffold_harness", "args": {"harness_directory": "tests/secretos", "test_filename": ".env", "harness_code": "X=1"},
     "expect": {"status": "REJECTED", "code": "SECRET_DENIED"}},
    {"id": "scaffold-escape", "tool": "znve_scaffold_harness", "args": {"harness_directory": "../outside/tests", "test_filename": "h.txt", "harness_code": "x"},
     "expect": {"status": "REJECTED", "code": "OUTSIDE_WORKSPACE"}}
  ]
}
