{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "allowed_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "required_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "required": {
            "type": "boolean"
          },
          "check_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
          }
        },
        "required": [
          "id",
          "description",
          "required",
          "check_id"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
          },
          "runner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 4096
            },
            "minItems": 0,
            "maxItems": 64
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 100,
            "maximum": 60000
          },
          "evidence_kind": {
            "type": "string",
            "enum": [
              "local",
              "component_real",
              "production_like"
            ]
          }
        },
        "required": [
          "id",
          "runner",
          "argv",
          "timeout_ms"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "human_intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "observable_outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "criterion_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
            },
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "statement",
          "criterion_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "check_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
            },
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "statement",
          "check_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "decision_records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
          },
          "lens": {
            "type": "string",
            "enum": [
              "fundamentals",
              "language",
              "systems",
              "data",
              "security",
              "product",
              "platform",
              "scale",
              "constraint"
            ]
          },
          "chosen": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "alternatives_rejected": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "reopen_when": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "id",
          "chosen",
          "alternatives_rejected",
          "rationale",
          "reopen_when"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "risk_budget": {
      "type": "object",
      "properties": {
        "impact": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "uncertainty": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "minimum_evidence": {
          "type": "string",
          "enum": [
            "local",
            "component_real",
            "production_like"
          ]
        }
      },
      "required": [
        "impact",
        "uncertainty",
        "minimum_evidence"
      ],
      "additionalProperties": false
    },
    "state_transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "criterion_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
            },
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true
          }
        },
        "required": [
          "from",
          "to",
          "criterion_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "allowed_effects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true
    },
    "reversibility": {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "reopen_when": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "strategy",
        "reopen_when"
      ],
      "additionalProperties": false
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "origin": {
            "type": "string",
            "enum": [
              "observed",
              "inferred",
              "external"
            ]
          },
          "evidence": {
            "type": "string",
            "enum": [
              "support",
              "refute",
              "both",
              "none"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "material": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "statement",
          "origin",
          "evidence",
          "source",
          "material"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true
    }
  },
  "required": [
    "id",
    "revision",
    "objective",
    "allowed_files",
    "required_files",
    "criteria",
    "checks",
    "assumptions"
  ],
  "additionalProperties": false
}
